#!/bin/sh
# Provision (v2, M27 agpkg→N4 aginx-pkg): runtime layers for /var/lib/aginx
# + pkg faces. All idempotent; none ever blocks the boot.
#
# Boot order (anchors below; check.sh HOME-PHASE gate reads them):
#   seed      — scaffold /var/lib/aginx/{done,skills,units,stamps}. Pure
#               mkdir; wiped trees re-create next boot. (Bake also scaffolds
#               — M26 state-tar members; Seed is the runtime belt-and-braces.)
#   repair    — #472① local every boot (offline): rebuild tree faces / heal
#               sidecars from persisted pkg.toml when /var/bin was wiped but
#               the ledger stayed. Net leg later when pending + internet.
#   resync    — aginx-pkg sync when core entries exist (all-opt L0 skips).
#               First install and self-heal are one path; units whose binary
#               landed this boot get `aginx-svc restart`.
#   finalize  — one-shot steps behind `aginx-done` (/var/lib/aginx/done):
#               run while unmarked, mark only on success. First tenant M28
#               (python loader + pip). Trust the artifact, not the mark.
#
# HOME three-phase (omacom Seed→Finalize→Resync borrow; agent black-box):
#   HOME-PHASE Seed:     bake only — build-rootfs `cp -R home/.` onto a fresh
#                        image. Never this script. Never OTA image overlay.
#   HOME-PHASE Finalize: dynamic first-boot that needs live state (pair /
#                        wizard / opt-in) — NOT silent skel copy. This script
#                        must not write under /home/ (gate in check.sh).
#   HOME-PHASE Resync:   preserve via state-restore after rootfs swap
#                        (/home rides STATE_TAR_MEMBERS). Destructive
#                        "clobber /home back to factory seed" is NOT a boot
#                        path — would need an explicit future tool + GO=1.
#
# net-bringup writes wifi/dhcp/internet (+ phase-1 local "done"); net
# failures never write done fail. This script writes ONLY the pkg lines.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/var/bin

STATE=/run/boot.state
say() { echo "$@" >>"$STATE"; }

# ---- seed -----------------------------------------------------------------
mkdir -p /var/lib/aginx/done /var/lib/aginx/skills /var/lib/aginx/units /var/lib/aginx/stamps

[ -f /etc/agpkg.manifest ] || exit 0
grep -qE '^[a-z]' /etc/agpkg.manifest || exit 0   # all entries commented

# ---- repair ①: local leg (every boot, offline, never blocks) ---------------
# Bare L0 (no stamps) logs "0 local, 0 mirror, 0 pending" and costs one
# fast no-op walk of the stamps dir.
RLOG=/var/tmp/aginx-pkg-repair.log
aginx-pkg repair >"$RLOG" 2>&1
# a face rebuilt/units revived this boot may belong to a unit that gave up
# restarting during the empty-/var/bin window (same law as resync's loop)
for u in $(sed -n 's/^aginx-pkg: rebuilt face \([^ ]*\).*/\1/p' "$RLOG" 2>/dev/null); do
  aginx-svc restart "$u" 2>/dev/null
done

# L0 (刀4): the manifest ships ALL-opt — sync has no core work, so the
# 6-minute net wait + sync are skipped entirely and the boot line goes
# straight to `pkg ok` (provision installs NOTHING by default; what runs
# on this phone is the user's opt-in). A future core entry re-arms the
# original semantics untouched. Tier grammar: field 4, absent = core —
# the baked append lines carry `opt <ver> [deps]` after the sha, so a
# "line ends in opt" grep would misread every one of them as core
# (busybox awk segfaults on this build — set-- field walk instead).
all_opt=1
while IFS= read -r line; do
  case "${line}" in ''|'#'*) continue ;; esac
  set -- ${line}
  [ "${4:-core}" = "opt" ] || all_opt=0
done < /etc/agpkg.manifest
if [ "${all_opt}" = "1" ]; then
  say pkg ok
else

# ---- wait for internet (resync + finalize both need it) -------------------
# Give net-bringup up to 6 minutes (radio + join + dhcp on a cold boot).
n=0
while [ $n -lt 180 ]; do
  grep -q '^internet ok' "$STATE" 2>/dev/null && break
  # #246: `done` is the local verdict now and lands long before the net
  # chain — the net-verdict early-outs are the wifi/dhcp/internet fail
  # lines instead of done fail (retries next boot, M27 discipline).
  grep -qE '^(wifi|dhcp|internet) fail' "$STATE" 2>/dev/null && exit 0
  sleep 2; n=$((n+1))
done
grep -q '^internet ok' "$STATE" || exit 0

# Clock gate (bake #11 receipt, 2026-09-03): a TLS download before ntpd
# sets the wall clock dies on cert validation ("not valid yet" vs the
# 1970 boot clock) — a fresh /var/bin after a rootfs swap made every
# mirror fetch fail this way while sync raced ahead of net-bringup's
# ntpd. The time verdict trails internet ok by net-bringup's bounded ntpd
# retry (~120 s, phase 2's last line — `done` landed back in phase 1),
# inside this 180 s wait; on time fail we still try (the RTC may be
# right — failure is then honest and logged).
n=0
while [ $n -lt 90 ]; do
  grep -qE '^time (ok|fail)' "$STATE" 2>/dev/null && break
  sleep 2; n=$((n+1))
done

# ---- resync ---------------------------------------------------------------
LOG=/var/tmp/aginx-pkg-sync.log
say pkg run
if aginx-pkg sync >"$LOG" 2>&1; then
  say pkg ok
else
  say pkg fail "see $LOG"
fi
# a binary installed this boot may belong to a unit that already gave up
# restarting during the empty-/var/bin window; revive what we refreshed
for u in $(sed -n 's/^aginx-pkg: installed \([^ ]*\).*/\1/p' "$LOG" 2>/dev/null); do
  aginx-svc restart "$u" 2>/dev/null
done
fi  # (a core entry present — wait + sync ran; all-opt took the early `pkg ok` above)

# ---- repair ②: net leg (only when the local leg left pending) --------------
# Binary packages have no local source (their bytes live only on the
# mirror); the asr/tts/ocr model trees are state-tar-excluded by D15
# law. Both re-fetch from the device's own manifest — which now rides
# the state tar (#472①), so a re-flash keeps the pins it was installed
# against. Behind the same internet + clock gates as resync (TLS on a
# 1970 clock dies); a hard net fail just leaves the pending list for
# the next boot — repair never blocks or fails the boot.
if grep -q '^aginx-pkg: repair-pending' "$RLOG" 2>/dev/null; then
  n=0
  while [ $n -lt 90 ]; do
    grep -q '^internet ok' "$STATE" 2>/dev/null && break
    grep -qE '^(wifi|dhcp|internet) fail' "$STATE" 2>/dev/null && break
    sleep 2; n=$((n+1))
  done
  if grep -q '^internet ok' "$STATE" 2>/dev/null; then
    n=0
    while [ $n -lt 45 ]; do
      grep -qE '^time (ok|fail)' "$STATE" 2>/dev/null && break
      sleep 2; n=$((n+1))
    done
    if aginx-pkg repair --net >"$RLOG.net" 2>&1; then
      say pkg heal ok
      for u in $(sed -n 's/^aginx-pkg: reinstalled \([^ ]*\).*/\1/p' "$RLOG.net" 2>/dev/null); do
        aginx-svc restart "$u" 2>/dev/null
      done
    else
      say pkg heal fail "see $RLOG.net"
    fi
  fi
fi

# ---- model links (2026-09-09 蛋案) ----------------------------------------
# asr/tts/ocr 三包的模型树住 pkgfiles（大件可重下物，不进 state tar），
# 而预编译 CLI 里的模型路径是编译期常量（/var/models/...）——每靴幂等
# symlink ensure（python-finalize 同法：信工件不信标记）。安装器把
# files/ 成员剥前缀落 pkgfiles/<pkg>/（lib.rs stream_member，设备实测
# 2026-09-09），故 src 无 files/ 段。实目录让位：全量镜像烤的
# /var/models/<sub> 是真身，包树不抢；src 未装（裸蛋）= 无操作。
ensure_model_link() {
  src="/var/lib/aginx/pkgfiles/$1/models/$2"
  dst="/var/models/$2"
  [ -d "$src" ] || return 0
  [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ] && return 0
  [ -d "$dst" ] && return 0
  mkdir -p "$(dirname "$dst")"
  ln -sfn "$src" "$dst"
}
mkdir -p /var/models
ensure_model_link aginx-asr asr
ensure_model_link aginx-tts tts/vits-melo-tts-zh_en
ensure_model_link aginx-ocr ocr

# ---- finalize (one-shot steps, aginx-done-gated) -------------------------
# System-level guarantee line (ARCH §13): the phone promises python3,
# not node. Re-seeded every boot — idempotent overwrite, no marker.
mkdir -p /var/lib/aginx/skills/_system
cat >/var/lib/aginx/skills/_system/SKILL.md <<'SYSEOF'
# _system — 系统级说明（provision seed，每靴覆写）

- **L0 无头底座**：provision 默认什么都不装——清单全 opt，装什么
  （python3/codex/母体/语音…）是用户自己的事（`aginx-pkg opt-in <name>`）。
- **python3 是包不是保证**：opt-in 后 `python3 -m pip` 装 musllinux
  aarch64 wheel；loader 链接由 python-finalize 幂等补。
- **node 不保证**：要 JS 运行时自己装（opt tier 或 wheel 生态替代）。
- 其余系统工具面以 `aginx commands --all` 为准（D13 路由器，文件即注册表）。
SYSEOF

# python3 loader link + pip sanity — the FIRST aginx-done tenant (M28).
# CPython musl builds exec via /lib/ld-musl-aarch64.so.1 (kernel ELF
# interpreter path, hardcoded); the loader rides the package tree, this
# step links it into /lib. python3 absent (sync failed/offline) => no
# mark, retried next boot — the M27 discipline.
# The `-e /lib/...` re-check: the marker lives in /var/lib (state tar,
# survives rootfs swaps) but the link itself does not — after a swap the
# marker would lie and python3 would die on a missing musl interpreter
# (bake #9 receipt, 2026-09-03). Trust the artifact, not the mark.
if ! aginx-done check python-finalize || [ ! -e /lib/ld-musl-aarch64.so.1 ]; then
  if [ -x /var/bin/python3 ]; then
    LOADER=/var/lib/aginx/pkgfiles/python3/lib/ld-musl-aarch64.so.1
    if [ -f "$LOADER" ] \
       && ln -sf "$LOADER" /lib/ld-musl-aarch64.so.1 \
       && /var/bin/python3 -c 'import sys,ssl,sqlite3,socket,json; print(sys.version)' >>/var/tmp/python-finalize.log 2>&1 \
       && /var/bin/python3 -m pip --version >>/var/tmp/python-finalize.log 2>&1; then
      aginx-done mark python-finalize
      say py ok "$(cat /var/tmp/python-finalize.log | head -1 | cut -c1-40)"
    else
      say py fail "see /var/tmp/python-finalize.log"
    fi
  fi
fi

exit 0
