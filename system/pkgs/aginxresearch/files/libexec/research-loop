#!/bin/sh
# research-loop (10-09 user ruling: serial = never idle) — continuous grinder.
# Round-robins the instances one round at a time; we are the engine's only
# caller, single grok account stays serial by construction. rc!=0 (rate limit
# / net flap) -> 300s backoff, else straight on. Cron research lines retired.
# v0.1.1 (#472 运维件归包): rode the package tree — the unit is pkg-owned
# (/var/lib/aginx/units/aginxresearch.toml), the hand /etc/aginx/svc.d copy
# retires.
# v0.3.5 (10-29 X2 停摆修): instance list was hardcoded to the redfin four —
# the X2 pilot dir never matched, so the loop slept ran=0 in silence for 5
# days. Discover dynamically: every /home/research/* dir carrying program.md
# is an instance (D14: instances are data).
export HOME=/root
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TZ=CST-8
mkdir -p /home/research/logs
# Machines are data (D14): a host without these instance dirs (fresh X2
# pilot) must idle politely, not error-loop or busy-spin.
while :; do
    ran=0
    for d in /home/research/*/; do
        [ -f "$d/program.md" ] || continue
        name=$(basename "$d")
        ran=1
        log=/home/research/logs/$name.log
        echo "=== $(date '+%F %T') $name (loop) ===" >> "$log"
        /var/bin/aginxresearch run "/home/research/$name" >> "$log" 2>&1
        rc=$?
        echo "--- rc=$rc" >> "$log"
        if [ $rc -ne 0 ]; then
            sleep 300
        else
            sleep 5
        fi
    done
    [ $ran -eq 0 ] && sleep 300
done
